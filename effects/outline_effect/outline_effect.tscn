[sub_resource type="GDScript" id="GDScript_kf30h"]
script/source = "extends Node3D

@export_range(2.0, 10.0, 0.1, \"or_greater\") var duration: float = 4.0

func _ready() -> void:
	var tween = create_tween()
	tween.tween_property(self, \"rotation:y\", PI/4.0, duration / 2.0)
	tween.tween_property(self, \"rotation:y\", 0.0, duration / 2.0)
	tween.tween_property(self, \"rotation:y\", -PI/4.0, duration / 2.0)
	tween.tween_property(self, \"rotation:y\", 0.0, duration / 2.0)
	tween.set_loops()
"

[sub_resource type="Shader" id="Shader_whl02"]
code = "shader_type canvas_item;

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
	int stencil = int(texture(TEXTURE, UV).r);
	vec3 stencil_color = hsv2rgb(vec3(float(stencil) / 255.0, 1.0, 1.0));
	COLOR = vec4(stencil_color, float(bool(stencil)));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_yel7k"]
shader = SubResource("Shader_whl02")

[sub_resource type="LabelSettings" id="LabelSettings_whl02"]
font_size = 32

[sub_resource type="GDScript" id="GDScript_whl02"]
script/source = "extends Label

func _process(delta: float) -> void:
	var stencil_test: StencilTest = get_parent()
	position = stencil_test._cache_mouse_position
	text = \"%s\" % stencil_test._cache_stencil_value
"

